{
	"name": "dfd_silver_billing",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_billing",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          charge_type = iif(isNull(charge_type) || trim(charge_type) == '',                       'Sin clasificar', trim(charge_type)),",
				"          payment_status = case( lower(trim(payment_status)) == 'paid', 'Paid',                     lower(trim(payment_status)) == 'pending', 'Pending',                     lower(trim(payment_status)) == 'unpaid', 'Unpaid',                     lower(trim(payment_status)) == 'overdue', 'Overdue',                     toString(null())),",
				"          amount = iif(regexReplace(trim(amount), '[^0-9.-]', '') == '',                       toDecimal(null(), 12, 2),                       toDecimal(regexReplace(trim(amount), '[^0-9.-]', ''), 12, 2))) ~> derivedColumn1",
				"derivedColumn1 derive(payment_date = case(   regexMatch(trim(payment_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),     toDate(trim(payment_date), 'yyyy-MM-dd'),   regexMatch(trim(payment_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),     toDate(trim(payment_date), 'dd-MMM-yyyy'),   regexMatch(trim(payment_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),     toDate(trim(payment_date), 'MMMM d, yyyy'),   regexMatch(trim(payment_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),     toDate(trim(payment_date), 'MM/dd/yyyy'),   regexMatch(trim(payment_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),     toDate(concat(substring(trim(payment_date), 1, 6),                   iif(toInteger(substring(trim(payment_date), 7, 2)) > 26, '19', '20'),                   substring(trim(payment_date), 7, 2)), 'MM-dd-yyyy'),   toDate(null()) )) ~> derivedColumn2",
				"derivedColumn2 split(!isNull(billing_id) && !isNull(admission_id) && !isNull(amount) && amount > 0 && amount <= 100000 && !isNull(payment_status),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos, source2 exists(split1@validos@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 aggregate(groupBy(billing_id),",
				"     admission_id = first(admission_id),",
				"          charge_type = first(charge_type),",
				"          amount = first(amount),",
				"          payment_status = first(payment_status),",
				"          payment_date = first(payment_date)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> sink1"
			]
		}
	}
}